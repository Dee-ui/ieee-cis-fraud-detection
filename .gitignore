# ---------------------------------------------------------
# Python
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

# ---------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------
.venv/
venv/
env/

# ---------------------------------------------------------
# Secrets. Never commit these.
# ---------------------------------------------------------
.env
kaggle.json
*.pem
*.key

# ---------------------------------------------------------
# Data. Too large for Git and fully re-downloadable.
# The .gitkeep exceptions preserve the empty folder structure.
# ---------------------------------------------------------
data/raw/*
data/interim/*
data/external/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/external/.gitkeep
*.zip

# ---------------------------------------------------------
# Trained models. Large binaries, regenerated by the pipeline.
# ---------------------------------------------------------
models/*
!models/.gitkeep

# ---------------------------------------------------------
# MLflow experiment tracking (Step 4)
# ---------------------------------------------------------
mlruns/
mlartifacts/
mlflow.db

# ---------------------------------------------------------
# CatBoost writes training logs into the working directory
# ---------------------------------------------------------
catboost_info/

# ---------------------------------------------------------
# Editor and OS noise. We keep shared VS Code settings on purpose.
# ---------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
.DS_Store
desktop.ini

# ---------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------
*.log
tmp/
temp/

# ---------------------------------------------------------
# Excluded from version control by choice: step6.md contains a
# demo API-token pattern that trips the secret-scan hook, and
# Untitled.ipynb is a scratch notebook that previously carried a
# real (now-revoked) token.
# ---------------------------------------------------------
docs/steps/step6.md
docs/steps/step7.md
Untitled.ipynb
